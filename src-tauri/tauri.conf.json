{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermGrid",
  "version": "0.2.0",
  "identifier": "dev.termgrid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermGrid",
        "width": 1400,
        "height": 900,
        "minWidth": 700,
        "minHeight": 450,
        "backgroundColor": "#14151c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../examples/AgentesClaude/": "AgentesClaude/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
