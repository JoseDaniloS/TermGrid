{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
